# Copy to .env (never commit .env). Generate values with: node cli.mjs gen-secret / node cli.mjs hash-password
LICENSE_PORT=8443
LICENSE_BIND=0.0.0.0
LICENSE_DB_PATH=./data/license.db
# 64 hex chars from `node cli.mjs gen-hmac`; paste the same value into LICENSE_CLIENT_HMAC in background.js
LICENSE_CLIENT_HMAC=
# scrypt hash from `node cli.mjs hash-password` (password read from stdin or LICENSE_ADMIN_PASSWORD)
LICENSE_ADMIN_PASSWORD_HASH=
# TLS terminates here unless you run behind a TLS-terminating proxy (then set LICENSE_ALLOW_HTTP=1 and LICENSE_TRUST_PROXY=1)
LICENSE_TLS_CERT_FILE=/certs/server.crt
LICENSE_TLS_KEY_FILE=/certs/server.key
LICENSE_ALLOW_HTTP=0
LICENSE_TRUST_PROXY=0
# REQUIRED: Ed25519 signing key (PKCS8, base64) from `node cli.mjs gen-signing-key`.
# Signs activation tokens; the matching PUBLIC key is baked into background.js. Server refuses to start without it.
LICENSE_SIGNING_KEY=
# Optional previous client HMAC, to rotate LICENSE_CLIENT_HMAC without downtime (accepted during a staged release).
LICENSE_CLIENT_HMAC_PREV=
# Admin UI on its own listener. Set a port to move /admin off the public port; publish it ONLY to the host loopback
# (compose: "127.0.0.1:8444:8444") and reach it over an SSH tunnel. In Docker, bind 0.0.0.0 in-container and let the
# host-loopback publish be the boundary. Leave unset to serve /admin on the main port to loopback callers only.
LICENSE_ADMIN_PORT=
LICENSE_ADMIN_BIND=0.0.0.0
